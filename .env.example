# GitHub's official hosted MCP server over HTTPS in read-only mode.
# Restrict a fine-grained PAT to the repositories you need, with read-only
# Contents and Pull requests permissions. Authorise SSO if your org requires it.
# No token is needed with --mock. Never commit .env or paste tokens into reports.
GITHUB_TOKEN=

# Anthropic credentials: required only for default review mode.
# Default review sends selected PR code/context to Anthropic.
# Use --context-only to collect GitHub context without an LLM request.
# Choose an explicit Claude model supporting tools and structured outputs.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000
MAX_LLM_OUTPUT_TOKENS=8192

MAX_AGENT_STEPS=8
MAX_TOOL_RESULT_CHARS=30000
MAX_FILES_TO_INSPECT=20
MAX_CONTEXT_CHARS=100000
MAX_PATCH_CHARS=10000
MCP_TIMEOUT_MS=15000
MIN_FINDING_CONFIDENCE=0.75
LOG_LEVEL=info
