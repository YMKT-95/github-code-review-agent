{
  "name": "github-code-review-agent",
  "version": "0.2.0",
  "private": true,
  "description": "A local, read-only GitHub PR review agent — Phase 2 MCP context collection",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "review": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.8"
  }
}
